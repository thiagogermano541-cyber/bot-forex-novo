# Copie para .env. Não versione o arquivo com credenciais.
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql+asyncpg://jarvis:change-this-database-password@postgres:5432/jarvis
REDIS_URL=redis://redis:6379/0
APP_ORIGIN=http://localhost:3000
JWT_SECRET=
ADMIN_EMAIL=admin@jarvis.local
ADMIN_PASSWORD=
COOKIE_SECURE=false

# API oficial Anthropic. Escolha um modelo disponível em sua conta.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_MAX_TOKENS=3000
CLAUDE_INPUT_TOKEN_LIMIT=26000
# Tarifas USD do modelo escolhido. Zero deixa Claude NÃO CONFIGURADO.
CLAUDE_INPUT_USD_PER_MILLION=0
CLAUDE_OUTPUT_USD_PER_MILLION=0
DAILY_AI_BUDGET_USD=5
ANALYSIS_INTERVAL_SECONDS=300
STALE_AFTER_SECONDS=90

KRAKEN_ENABLED=true
# Conta OANDA com acesso ao instrumento XAU_USD; disponibilidade depende da região.
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
# Dados macro opcionais; não representa um calendário de notícias.
FRED_API_KEY=

# Chats autorizados separados por vírgula. Ativar habilita envios reais do worker.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
EVALUATION_HORIZON_MINUTES=60
